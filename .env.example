#APP
NODE_ENV=development
PORT=3000
HASH_SALT=10

#JWT
JWT_ACCESS_SECRET=secret
JWT_REFRESH_SECRET=secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

#DB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_DATABASE=skillswap
DB_SYNCHRONIZE=true
DB_LOGGING=true