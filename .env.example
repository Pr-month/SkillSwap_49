# ============================================================
# SkillSwap API — пример окружения
# Скопируйте в .env и замените значения-заглушки на реальные.
# ============================================================

# APP
NODE_ENV=development
PORT=3000
HASH_SALT=10

# За прокси-сервером (nginx и т.п.) установите true, чтобы
# rate limiting учитывал реальный IP клиента из X-Forwarded-For.
TRUST_PROXY=false

# JWT
# ВАЖНО: не используйте значения-заглушки ("secret", "changeme" и т.п.).
# В production секреты должны быть разными, длиной не менее 32 символов.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# DB
# Либо строка подключения:
# DATABASE_URL=postgres://user:password@localhost:5432/skillswap
# Либо отдельные параметры:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_DATABASE=skillswap

# В production всегда false: схема управляется миграциями (npm run migration:run).
# true допустимо только для локальной разработки и тестов.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Rate limiting (количество запросов / окно в секундах)
# Общий лимит для всех маршрутов.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Строгий лимит для auth/register, auth/login и auth/refresh.
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
